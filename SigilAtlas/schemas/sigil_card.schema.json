{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sigil Card",
  "type": "object",
  "additionalProperties": false,
  "required": ["sigilId", "title", "accent", "badges", "callouts"],
  "properties": {
    "sigilId": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "title": {
      "type": "string"
    },
    "accent": {
      "type": "string",
      "pattern": "^#[0-9A-Fa-f]{6}$"
    },
    "badges": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "callouts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    }
  }
}
