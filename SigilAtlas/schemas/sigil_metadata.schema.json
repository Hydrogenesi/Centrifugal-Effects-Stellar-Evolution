{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sigil Metadata",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "operatorClass",
    "tier",
    "geometryFamily",
    "invocationDomains",
    "summary",
    "geometryProperties",
    "svg",
    "card",
    "stellarIntegration"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "name": {
      "type": "string"
    },
    "operatorClass": {
      "type": "string",
      "enum": ["stability", "rotation", "transport", "resonance"]
    },
    "tier": {
      "type": "string",
      "enum": ["foundation", "advanced", "mythic"]
    },
    "geometryFamily": {
      "type": "string",
      "enum": ["radial", "spiral", "lattice", "orbital"]
    },
    "invocationDomains": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": ["initialization", "calibration", "visualization", "parameter-sweep"]
      }
    },
    "summary": {
      "type": "string"
    },
    "geometryProperties": {
      "type": "object",
      "additionalProperties": false,
      "required": ["symmetryOrder", "closedPath", "anchorCount"],
      "properties": {
        "symmetryOrder": {
          "type": "integer",
          "minimum": 1
        },
        "closedPath": {
          "type": "boolean"
        },
        "anchorCount": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "svg": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "metadataKey"],
      "properties": {
        "file": {
          "type": "string"
        },
        "metadataKey": {
          "type": "string",
          "const": "sigilAtlas"
        }
      }
    },
    "card": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "title", "accent"],
      "properties": {
        "file": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "accent": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        }
      }
    },
    "stellarIntegration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mappingFile", "compatibility"],
      "properties": {
        "mappingFile": {
          "type": "string"
        },
        "compatibility": {
          "type": "object",
          "additionalProperties": false,
          "required": ["inputFormat", "supportedParameters"],
          "properties": {
            "inputFormat": {
              "type": "string",
              "const": "stellar-evolution:v1"
            },
            "supportedParameters": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "enum": [
                  "mass",
                  "initial_density",
                  "initial_luminosity",
                  "initial_temperature",
                  "time_start",
                  "time_stop",
                  "num_steps",
                  "rotation_factor",
                  "centrifugal_enhancement",
                  "evolution_track_variant"
                ]
              }
            }
          }
        }
      }
    }
  }
}
