{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Embedded SVG Metadata",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "sigilId", "operatorClass", "geometryFamily", "anchorPoints"],
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "sigilId": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "operatorClass": {
      "type": "string",
      "enum": ["stability", "rotation", "transport", "resonance"]
    },
    "geometryFamily": {
      "type": "string",
      "enum": ["radial", "spiral", "lattice", "orbital"]
    },
    "anchorPoints": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "x", "y"],
        "properties": {
          "label": {
            "type": "string"
          },
          "x": {
            "type": "number"
          },
          "y": {
            "type": "number"
          }
        }
      }
    }
  }
}
